# Salin file ini menjadi .env lalu isi key yang Anda punya. Semua opsional.
# Copy this file to .env and fill in the keys you have. All optional.

# Relay API v3 (wajib setelah 24 Nov 2026 / required after Nov 24, 2026)
# https://dashboard.relay.link -> API keys -> Create key
RELAY_API_KEY=

# Tab 5 Solana: riwayat transaksi yang sudah di-parse, jauh lebih cepat dari RPC publik
# Tab 5 Solana: parsed transaction history, far faster than the public RPC
# https://dashboard.helius.dev (free tier)
HELIUS_API_KEY=

# Tab 5 EVM: satu key untuk Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain
# Tab 5 EVM: one key for Ethereum, Base, Arbitrum, Optimism, Polygon, BNB Chain
# https://etherscan.io/myapikey (free tier)
ETHERSCAN_API_KEY=

# RPC kustom (opsional) / custom RPC endpoints (optional)
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
# RPC_BASE=https://base-rpc.publicnode.com
